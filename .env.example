# Copy this file to .env and fill in your CyVerse credentials.
# Do not commit .env.

IRODS_HOST=data.cyverse.org
IRODS_PORT=1247
IRODS_ZONE_NAME=iplant
IRODS_USER_NAME=
IRODS_USER_PASSWORD=

# Upload destination from the CyVerse Discovery Environment URL.
CYVERSE_DEST=/iplant/home/shared/esiil/Fire_Vase

# Local package built by scripts/prepare_data_lake.py.
DATA_LAKE_PACKAGE=data_lake/fire-vase-data-lake-v0.1
